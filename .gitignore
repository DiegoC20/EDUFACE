students/*.png
students/*.jpeg
!students/.gitkeep

# Logs de aplicación
logs/
*.log

# Build artifacts
build/
dist/

# DeepFace: ignorar representaciones / artefactos pesados
db/**/representations_*.pkl
db/**/*.pkl

# Permitir imágenes de ejemplo en db/
!db/**/*.jpg
!db/**/*.jpeg
!db/**/*.png
!db/**/*.gif
!db/**/.gitkeep
!db/**/README.md

